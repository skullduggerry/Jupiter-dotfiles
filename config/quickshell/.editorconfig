# 4-space indent, no tabs, project-wide.
# PROJECT_STRUCTURE.md and llm.md both assume this; it was documented as
# existing but the file was never actually committed.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
