{#- The Settings app's accent and font, and the glass the apps get, for the
    other templates. apply.sh renders from a copy of templates/ with this file
    written by appearance.py, from $XDG_STATE_HOME/quickshell/appearance.json
    and the tint the shell recorded beside it; as committed, it holds the
    defaults the shell starts with. -#}
{%- macro accent_color() -%}{{ color4 }}{%- endmacro -%}
{%- macro font_family() -%}JetBrainsMono Nerd Font{%- endmacro -%}
{#- Kvantum's window and dialog backgrounds at the shell's tint. -#}
{%- macro window_opacity() -%}0.60{%- endmacro -%}
