{#- Rendered to ~/.cache/wallust/kdeglobals, which apply.sh merges into
    ~/.config/kdeglobals key by key: KDE apps keep settings of their own in that
    file too. Rendered as ~/.local/share/color-schemes/Wallust.colors as well,
    the colour scheme [UiSettings] names: outside Plasma, KDE apps take their
    colours from there. KColorScheme reads the colours as R,G,B decimals, hence
    rgb(). -#}
{%- from "palette.jinja" import shade, selection, scheme, accent -%}
{%- macro rgb(value) -%}{{ value | rgb }}{%- endmacro -%}
[General]
ColorScheme=Wallust
Name=Wallust

[Icons]
Theme={{ "breeze" if scheme() == "light" else "breeze-dark" }}

[KDE]
widgetStyle=kvantum
SingleClick=false
LookAndFeelPackage=

[UiSettings]
ColorScheme=Wallust

[Colors:Window]
BackgroundNormal={{ background | rgb }}
BackgroundAlternate={{ rgb(shade(0.04)) }}
ForegroundNormal={{ foreground | rgb }}
ForegroundInactive={{ rgb(shade(0.58)) }}
ForegroundActive={{ rgb(accent(0)) }}
ForegroundLink={{ color4 | rgb }}
ForegroundVisited={{ color5 | rgb }}
ForegroundNegative={{ color1 | rgb }}
ForegroundNeutral={{ color3 | rgb }}
ForegroundPositive={{ color2 | rgb }}
DecorationFocus={{ rgb(accent(0)) }}
DecorationHover={{ rgb(accent(0)) }}

