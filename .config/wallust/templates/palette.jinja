{#- Colour arithmetic for the other templates, which import it:

        {% from "palette.jinja" import shade, selection %}

    The same formulas as .config/quickshell/style/Colors.qml, so the apps and
    the shell agree: every surface is a mix of the background and the text,
    which is what lets a light theme mirror a dark one. -#}

{%- from "appearance.jinja" import accent_name -%}

{%- macro channel(a, b, t) -%}
{%- set value = ((a | int) * (1 - t) + (b | int) * t) | round | int -%}
{{- "%02x" | format(0 if value < 0 else (255 if value > 255 else value)) -}}
{%- endmacro -%}

{#- t of the way from a to b; outside 0..1 it keeps going, clamped. -#}
{%- macro mix(a, b, t) -%}
#{{ channel(a | red, b | red, t) }}{{ channel(a | green, b | green, t) }}{{ channel(a | blue, b | blue, t) }}
{%- endmacro -%}

{#- WCAG's relative luminance, and the contrast of a colour with the
    background, from 1 to 21. -#}
{%- macro linear(v) -%}
{%- set c = (v | int) / 255 -%}
{{- c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4 -}}
{%- endmacro -%}
{%- macro luminance(value) -%}
{{- 0.2126 * (linear(value | red) | float) + 0.7152 * (linear(value | green) | float) + 0.0722 * (linear(value | blue) | float) -}}
{%- endmacro -%}
{%- macro contrast(value) -%}
{%- set a = luminance(value) | float -%}
{%- set b = luminance(background) | float -%}
{{- ([a, b] | max + 0.05) / ([a, b] | min + 0.05) -}}
{%- endmacro -%}

{#- A generated palette fills the terminal's slots by brightness rather than
    hue, so a slot stands for its colour only when it is saturated (HSL) and
    stands off the background; otherwise the colour the shell falls back to.
    Colors.qml's distinct() and slot(). -#}
{%- macro distinct(value) -%}
{%- set channels = [value | red | int, value | green | int, value | blue | int] -%}
{%- set high = (channels | max) / 255 -%}
{%- set low = (channels | min) / 255 -%}
{%- set saturation = 0 if high == low else (high - low) / (1 - (high + low - 1) | abs) -%}
{{- "yes" if saturation >= 0.25 and (contrast(value) | float) >= 2 else "" -}}
{%- endmacro -%}
{%- macro slot(value, fallback) -%}{{ value if distinct(value) else fallback }}{%- endmacro -%}

{#- The shell's colours (Colors.qml's palette), which the apps' roles take. -#}
{%- macro blue() -%}{{ slot(color4, "#61afef") }}{%- endmacro -%}
{%- macro red() -%}{{ slot(color1, "#e06c75") }}{%- endmacro -%}
{%- macro green() -%}{{ slot(color2, "#98c379") }}{%- endmacro -%}
{%- macro yellow() -%}{{ slot(color3, "#e5c07b") }}{%- endmacro -%}
{%- macro purple() -%}{{ slot(color5, "#c678dd") }}{%- endmacro -%}
{%- macro cyan() -%}{{ slot(color6, "#56b6c2") }}{%- endmacro -%}
{#- Terminal palettes carry no orange; halfway from red to yellow is one. -#}
{%- macro orange() -%}
{{- mix(red(), yellow(), 0.5) if distinct(color1) and distinct(color3) else "#d19a66" -}}
{%- endmacro -%}

{#- The Settings app's accent (appearance.jinja), as Colors.qml's
    accentColor() picks it. -#}
{%- macro accent_color() -%}
{%- set name = accent_name() -%}
{{- purple() if name == "purple" else cyan() if name == "cyan" else green() if name == "green" else orange() if name == "orange" else red() if name == "red" else blue() -}}
{%- endmacro -%}

{#- t of the way from the background to the text. Below 0 is further from the
    text than the background: darker in a dark theme, lighter in a light one. -#}
{%- macro shade(t) -%}{{ mix(background, foreground, t) }}{%- endmacro -%}

{#- The Settings app's accent (appearance.jinja), towards white (t > 0) or
    black (t < 0). -#}
{%- macro accent(t) -%}
{{ mix(accent_color(), "#ffffff", t) if t >= 0 else mix(accent_color(), "#000000", -t) }}
{%- endmacro -%}

{#- Selected rows: the accent t over the background, under ordinary text. -#}
{%- macro selection(t) -%}{{ mix(background, accent_color(), t) }}{%- endmacro -%}

{#- "light" when the background is, by HSL lightness as Colors.qml judges it. -#}
{%- macro scheme() -%}
{%- set r = background | red | int -%}
{%- set g = background | green | int -%}
{%- set b = background | blue | int -%}
{{- "light" if ([r, g, b] | max) + ([r, g, b] | min) > 255 else "dark" -}}
{%- endmacro -%}

{#- base16's slots, which are roles, not the terminal's colours: 00 to 07 run
    from the background to the text, 08 to 0F are the accents. The surfaces
    are the shell's. nvim (nvim.lua) and, on NixOS, the apps Stylix themes
    (base16.json) take theirs from here, so the two agree. -#}
{%- macro base16(slot) -%}
{{- {
    "00": background,
    "01": shade(0.08),
    "02": shade(0.16),
    "03": shade(0.42),
    "04": shade(0.58),
    "05": foreground,
    "06": shade(0.9),
    "07": foreground,
    "08": red(),
    "09": orange(),
    "0A": yellow(),
    "0B": green(),
    "0C": cyan(),
    "0D": blue(),
    "0E": purple(),
    "0F": mix(red(), background, 0.4),
}[slot] -}}
{%- endmacro -%}
