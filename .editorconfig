root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{qml,js}]
indent_style = space
indent_size = 4

[qmldir]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

# shfmt reads these.
[{*.sh,pre-commit,pre-push}]
indent_style = space
indent_size = 4
switch_case_indent = true

# stylua reads these: Hyprland's config is indented with tabs, and a bind
# stays on one line.
[*.lua]
indent_style = tab
max_line_length = 160
